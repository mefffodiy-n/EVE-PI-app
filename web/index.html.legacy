<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PI Director</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ═══ Общие токены ═══════════════════════════════════════════════════
   Две вкладки говорят на разных визуальных языках намеренно:
   дашборд повторяет игровое окно Planetary Industry, чтобы взгляд
   переносился между игрой и планировщиком без переучивания;
   настройки — плотная таблица решений, где важны числа, а не иконки. */
:root {
  --void:#080b11; --hull:#0f141c; --seam:#1b2331;
  --dim:#6d7d92; --read:#ccd6e0; --bright:#f2f6fa;
  --amber:#d4a04a; --flux:#4f9cd6; --forge:#c8823c; --alarm:#cf6058; --calm:#4a9d7f;
  /* Цвета колец повторяют игровые: синий — инфраструктура,
     бирюзовый — экстрактор, оранжевый — производство. */
  --ring-infra:#3a9fd8; --ring-extract:#2fb89a; --ring-basic:#c8763a; --ring-adv:#d8a63c;
}
/* Светлая тема. Меняются только переменные — правил дублировать
   не нужно. */
body.light {
  --void:#eef1f5; --hull:#f7f9fb; --seam:#d3dae3;
  --dim:#5d6b7d; --read:#26303c; --bright:#0d151f;
  --amber:#9a6b12; --flux:#1d6fa8; --forge:#a05f1c; --alarm:#b03e36; --calm:#2c7358;
  --ring-infra:#1d7fb8; --ring-extract:#1a8c72; --ring-basic:#a85c26; --ring-adv:#a87d20;
}

/* Смена темы переключает переменные на body, из-за чего браузер
   пересчитывает стиль всего поддерева. Каждый элемент с transition
   на цвете запустил бы свою анимацию — на длинном плане это сотни
   одновременных анимаций. На время переключения переходы глушим. */
.theme-switching *, .theme-switching *::before, .theme-switching *::after {
  transition:none !important; animation:none !important;
}

* { box-sizing:border-box; }
body { margin:0; background:var(--void); color:var(--read);
       font-family:'IBM Plex Sans',system-ui,sans-serif; font-size:13px; line-height:1.45; }
.num { font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums; }
button { font-family:inherit; }

/* ═══ Шапка приложения ═══════════════════════════════════════════ */
/* Панель переносится на вторую строку, а не прокручивается: скрытая
   за краем кнопка — это кнопка, которой нет. На узких экранах часть
   индикаторов убирается (см. медиазапросы внизу) — они справочные,
   в отличие от кнопок. */
/* Панель закреплена сверху: индикаторы и кнопки нужны в любой момент
   прокрутки, а план бывает длиной в десятки колоний. */
.topbar { position:sticky; top:0; z-index:60;
          display:flex; align-items:center; gap:4px 6px; padding:6px 14px; min-height:46px;
          border-bottom:1px solid var(--seam); background:var(--hull); flex-wrap:wrap; }
.topbar > * { flex:0 0 auto; }
.brand { font-weight:600; color:var(--bright); margin-right:18px; letter-spacing:.02em; }
.brand small { color:var(--dim); font-weight:400; margin-left:7px; }
.tab { white-space:nowrap; background:none; border:none; border-bottom:2px solid transparent; color:var(--dim);
       padding:12px 14px; cursor:pointer; font-size:13px; }
.tab:hover { color:var(--read); }
.tab.on { color:var(--bright); border-bottom-color:var(--flux); }
.topbar .right { margin-left:auto; display:flex; gap:6px; align-items:center; }

/* Полоски статуса: разделены рамками, как приборные показания.
   Каждая отвечает на один вопрос и не требует пояснений. */
.chip { display:flex; align-items:center; gap:7px; padding:5px 11px;
        border:1px solid var(--seam); color:var(--dim); font-size:12px;
        font-family:'IBM Plex Mono',monospace; white-space:nowrap; }
.chip b { color:var(--read); font-weight:500; }
.chip .dot { width:7px; height:7px; border-radius:50%; background:var(--calm); }
.chip .dot.off { background:var(--dim); }
.chip .dot.stale { background:var(--amber); }

.hbtn { background:none; border:1px solid var(--seam); color:var(--read);
        padding:5px 12px; cursor:pointer; font-size:12px; }
.hbtn:hover { border-color:var(--flux); color:var(--flux); }
.langs { display:flex; border:1px solid var(--seam); }
.langs button { background:none; border:none; color:var(--dim); padding:5px 10px;
                cursor:pointer; font-size:12px; font-family:'IBM Plex Mono',monospace; }
.langs button.on { background:var(--seam); color:var(--bright); }
.icon-btn { width:30px; height:28px; display:grid; place-items:center; background:none;
            border:1px solid var(--seam); color:var(--dim); cursor:pointer; }
.icon-btn:hover { color:var(--amber); border-color:var(--amber); }
.icon-btn svg { width:15px; height:15px; }
.sso { background:none; border:1px solid #2b3a4d; color:var(--flux);
       padding:5px 14px; cursor:pointer; font-size:12px; }
.sso:hover { background:rgba(79,156,214,.1); }

/* ── Модальные окна: справка и о проекте ────────────────────────── */
.modal { position:fixed; inset:0; background:rgba(4,6,10,.72); z-index:80;
         display:none; align-items:flex-start; justify-content:center; padding:60px 20px; }
.modal.on { display:flex; }
.modal-box { background:var(--hull); border:1px solid var(--seam);
             width:min(860px,100%); max-height:80vh; display:flex; flex-direction:column; }
.modal-head { display:flex; align-items:center; padding:14px 18px;
              border-bottom:1px solid var(--seam); }
.modal-head h2 { margin:0; font-size:13px; letter-spacing:.1em; text-transform:uppercase;
                 color:var(--read); font-weight:600; }
.modal-head button { margin-left:auto; width:28px; height:28px; background:none;
                     border:1px solid var(--seam); color:var(--dim); cursor:pointer; font-size:15px; }
.modal-body { overflow-y:auto; padding:18px; }
.modal-body h3 { font-size:12px; letter-spacing:.09em; text-transform:uppercase;
                 color:var(--flux); font-weight:600; margin:22px 0 8px; }
.modal-body h3:first-child { margin-top:0; }
.modal-body p, .modal-body li { max-width:74ch; }
.modal-body ol, .modal-body ul { padding-left:20px; }
.modal-body li { margin-bottom:5px; }
.modal-body dl { display:grid; grid-template-columns:170px 1fr; gap:7px 16px; margin:0; }
.modal-body dt { color:var(--read); font-weight:500; }
.modal-body dd { margin:0; color:var(--dim); }
.modal-body a { color:var(--flux); }
.modal-body .warn { border-left:2px solid var(--amber); background:rgba(212,160,74,.06);
                    padding:8px 12px; margin:12px 0; }

.page { display:none; }
.page.on { display:block; }

/* ═══ Панель инструментов дашборда ═══════════════════════════════ */
/* Панель вида прилипает под шапкой: переключатели и кнопка экспорта
   тоже нужны при прокрутке. Отступ сверху вычисляется скриптом,
   потому что высота шапки зависит от того, перенеслась ли она. */
.tools { position:sticky; top:var(--topbar-h,46px); z-index:55; background:var(--void);
         display:flex; align-items:center; gap:2px; padding:8px 14px; flex-wrap:wrap;
         border-bottom:1px solid var(--seam); }
.tool { width:30px; height:26px; display:grid; place-items:center; cursor:pointer;
        background:none; border:1px solid transparent; color:var(--dim); border-radius:3px; }
.tool:hover { color:var(--read); background:#141b26; }
.tool.on { color:var(--bright); border-color:var(--seam); background:#141b26; }
.tool svg { width:15px; height:15px; }
.counts { margin-left:auto; color:var(--dim); font-size:12px; }
.counts b { color:var(--read); font-weight:500; }
.counts .idle { color:var(--amber); }

.menu { position:relative; }
.menu-pop { position:absolute; top:30px; left:0; z-index:20; min-width:230px;
            background:#0d121a; border:1px solid var(--seam); padding:4px 0; display:none; }
.menu.open .menu-pop { display:block; }
.menu-pop button { display:flex; gap:8px; width:100%; text-align:left; background:none;
                   border:none; color:var(--read); padding:6px 12px; cursor:pointer; font-size:13px; }
.menu-pop button:hover { background:#161e2a; }
.menu-pop button .mark { width:12px; color:var(--flux); }

/* ═══ Круг колонии: планета, кольцо, время, портрет ══════════════ */
.orb { position:relative; width:var(--orb,58px); height:var(--orb,58px); flex:0 0 auto; cursor:pointer; }
.orb .disc { position:absolute; inset:5px; border-radius:50%; overflow:hidden;
             background:#101720; display:grid; place-items:center; }
.orb .disc img { width:100%; height:100%; object-fit:cover; }
.orb .cargo { position:absolute; inset:0; margin:auto; width:52%; height:52%;
              filter:drop-shadow(0 1px 2px rgba(0,0,0,.8)); }
.orb svg.ring { position:absolute; inset:0; transform:rotate(-90deg); }
.orb .ring circle { fill:none; stroke-width:2.5; }
.orb .ring .track { stroke:#1c2532; }
/* Стрелки направлений медленно проступают поверх планеты — так в игре
   обозначается, что по колонии можно кликнуть. Чисто декоративный
   элемент, никаких данных не несёт. */
.orb .arrows { position:absolute; inset:12%; opacity:0; pointer-events:none;
               animation:breathe 5s ease-in-out infinite; }
.orb .arrows svg { width:100%; height:100%; fill:none; stroke:#c8d4e2; stroke-width:1.4; }
@keyframes breathe { 0%,100%{opacity:0} 45%,55%{opacity:.55} }
.orb:hover .arrows { opacity:.75; animation:none; }

/* Внутреннее кольцо — ход производственного цикла. */
.orb .ring .cycle { stroke:#e8eef5; stroke-width:2; }
.orb .ring .cycle.none { stroke:#2a3644; stroke-dasharray:2 4; }
.orb.busy .outer { filter:drop-shadow(0 0 3px currentColor); }

.orb .badge { position:absolute; top:-3px; left:-2px; z-index:3;
              background:#12181f; border:1px solid #253040; border-radius:3px;
              padding:0 4px; font-size:10px; line-height:14px;
              font-family:'IBM Plex Mono',monospace; color:var(--amber); }
.orb .badge.hot { color:var(--alarm); border-color:#4a2a2a; }
/* Портрет персонажа придёт из игры в Фазе 3. Пока — инициалы:
   пустой серый круг выглядит как незагрузившаяся картинка. */
.orb .pilot { position:absolute; right:-2px; bottom:-2px; width:40%; height:40%;
              border-radius:50%; border:1px solid #0a0f16; background:#232d3d;
              display:grid; place-items:center; font-size:9px; font-weight:600;
              color:#8fa3bd; letter-spacing:-.02em; }
.orb .pilot img { width:100%; height:100%; object-fit:cover; }

/* ═══ Вид «Детали»: строка на колонию ═══════════════════════════ */
.colony { border-bottom:1px solid #121824; padding:12px 14px;
          content-visibility:auto; contain-intrinsic-size:auto 190px; }
.colony:hover { background:#0c1119; }
.colony-head { display:flex; align-items:center; gap:10px; }
.pilot-lg { width:30px; height:30px; border-radius:50%; background:#232d3d; flex:0 0 auto;
            display:grid; place-items:center; font-size:11px; font-weight:600; color:#8fa3bd; }
.pilot-lg img { width:100%; height:100%; object-fit:cover; }
.pilot-name { color:var(--bright); font-weight:500; }
.sub { color:var(--dim); font-size:12px; display:flex; gap:8px; align-items:center; margin-top:1px; }
.sysbadge { background:#1a2332; border-radius:3px; padding:1px 6px;
            font-family:'IBM Plex Mono',monospace; font-size:11px; color:var(--read); }
.sec { font-family:'IBM Plex Mono',monospace; font-size:11px; padding:1px 5px; border-radius:3px; }
.colony-head .tail { margin-left:auto; text-align:right; }
.tail .lbl { color:var(--dim); font-size:11px; }
.tail .val { font-family:'IBM Plex Mono',monospace; color:var(--read); }
.tail .val.hot { color:var(--alarm); }
.details-btn { margin-left:12px; background:none; border:1px solid #2b3a4d; color:var(--flux);
               padding:5px 12px; cursor:pointer; font-size:12px; border-radius:2px; }
.details-btn:hover { background:rgba(79,156,214,.1); }
/* Круги переносятся на следующую строку при нехватке ширины.
   Строка колонии из-за этого меняет высоту, поэтому у .colony
   задан contain-intrinsic-size с запасом. */
.strip { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; padding-left:2px; }

/* ═══ Вид «Список»: строка на персонажа ═════════════════════════ */
.pilot-row { display:flex; align-items:center; gap:12px; padding:10px 14px;
             border-bottom:1px solid #121824; content-visibility:auto; contain-intrinsic-size:auto 78px; }
.pilot-row .who { width:150px; flex:0 0 auto; }
.pilot-row .orbs { display:flex; gap:10px; flex-wrap:wrap; }

/* ═══ Вид «Сетка» ═══════════════════════════════════════════════ */
.grid { display:flex; flex-wrap:wrap; gap:12px; padding:14px; }

/* ═══ Панель колонии ════════════════════════════════════════════ */
/* Детали колонии — не боковая панель, а замена содержимого страницы,
   как в игре. Кнопка «Назад» возвращает к списку. */
.colony-page { display:none; }
.colony-page.on { display:block; }
.cp-head { display:flex; align-items:center; gap:12px; padding:14px 16px; }
.cp-head .back { margin-left:auto; background:none; border:1px solid #2b3a4d;
                 color:var(--flux); padding:6px 16px; cursor:pointer; font-size:13px; }
.cp-head .back:hover { background:rgba(79,156,214,.1); }

/* Круг структуры стоит СЛЕВА, вне панели строки — как в игре. */
.unit { display:flex; gap:14px; align-items:flex-start; padding:0 16px 8px; }
.unit .panel { flex:1; min-width:0; background:#0d121a; border:1px solid #141c27;
               padding:8px 12px; }
.unit .title { color:var(--read); display:flex; align-items:center; gap:7px; }
.unit .title .code { color:var(--dim); }
.unit .cols2 { display:grid; grid-template-columns:1fr 1fr; gap:4px 24px; margin-top:6px; max-width:640px; }
.unit .lbl { color:var(--dim); font-size:11px; }
.unit .meta { color:var(--dim); font-size:12px; }
.unit .val { font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--read); }
.state-ok { color:var(--calm); } .state-wait { color:var(--dim); }
.inputs { display:flex; gap:4px; margin-top:3px; }
.inputs span { width:26px; height:26px; background:#101823; border:1px solid #1c2734;
               display:grid; place-items:center; }
.inputs span.have { background:#12314a; border-color:#2d5f86; }
.inputs img { width:20px; height:20px; object-fit:contain; }
.meter { height:4px; background:#151c27; margin:5px 0 3px; max-width:280px; }
.meter i { display:block; height:100%; }
.meter i.cpu { background:var(--ring-extract); }
.meter i.pg { background:var(--alarm); }
.meter i.pg.ok { background:var(--ring-infra); }

/* ═══ Настройки (плотная панель решений) ════════════════════════ */
.answers { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
           border-bottom:1px solid var(--seam); background:var(--hull); }
.answer { padding:11px 14px; border-right:1px solid var(--seam); }
.answer:last-child { border-right:none; }
.answer .label { color:var(--dim); font-size:11px; letter-spacing:.08em; text-transform:uppercase; }
.answer .value { font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums;
                 font-size:25px; color:var(--bright); line-height:1.15; margin-top:2px; }
.answer .value.warn { color:var(--amber); }
.answer .unit-s { font-size:13px; color:var(--dim); margin-left:5px; font-family:'IBM Plex Sans',sans-serif; }
.answer .note { color:var(--dim); font-size:12px; }
.split { display:grid; grid-template-columns:270px 1fr; min-height:calc(100vh - 150px); }
.rail { border-right:1px solid var(--seam); padding:14px; background:var(--hull); }
.rail h2 { font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--dim);
           font-weight:500; margin:0 0 10px; }
.rail h2:not(:first-child) { margin-top:20px; padding-top:16px; border-top:1px solid var(--seam); }
.field { margin-bottom:11px; }
.field label { display:block; font-size:12px; color:var(--dim); margin-bottom:3px; }
.field select, .field input { width:100%; background:var(--void); border:1px solid var(--seam);
    color:var(--read); padding:6px 8px; font-family:'IBM Plex Mono',monospace; font-size:12px; }
.field select:focus, .field input:focus { outline:none; border-color:var(--flux); }
.run { width:100%; margin-top:6px; padding:8px; cursor:pointer; background:transparent;
       border:1px solid var(--flux); color:var(--flux); font-size:13px; font-weight:500; }
.run:hover { background:rgba(79,156,214,.1); }
.crew { max-height:210px; overflow-y:auto; }
.crew div { display:flex; gap:8px; align-items:center; padding:4px 0; font-size:12px; }
.crew .lv { margin-left:auto; color:var(--dim); font-family:'IBM Plex Mono',monospace; font-size:11px; }

table { width:100%; border-collapse:collapse; }
thead .group th { text-align:left; padding:8px 10px 2px; font-size:11px; font-weight:600;
    letter-spacing:.08em; text-transform:uppercase; color:var(--dim);
    border-bottom:1px solid var(--seam); border-left:1px solid var(--seam); }
thead .group th small { display:block; font-weight:400; letter-spacing:0; text-transform:none;
    color:#48566a; font-size:11px; }
thead .cols th { text-align:left; padding:5px 10px; font-size:11px; font-weight:500;
    letter-spacing:.05em; text-transform:uppercase; color:#55637a;
    border-bottom:1px solid var(--seam); }
thead .cols th.r { text-align:right; }
tbody tr { border-bottom:1px solid #131a24; content-visibility:auto; contain-intrinsic-size:auto 38px; }
tbody tr:hover { background:#0d121a; }
td { padding:6px 10px; }
td.r { text-align:right; }
.idx { color:#465366; width:28px; text-align:right; }
.stack { display:flex; height:5px; background:#151c27; width:140px; position:relative; }
.stack::after { content:''; position:absolute; left:90%; top:-2px; bottom:-2px; width:1px; background:#3a4557; }
.stack i { display:block; height:100%; }
.s-str { background:#3d6f9e; } .s-hed { background:#7c6bb0; } .s-lnk { background:var(--amber); }
.parts { font-size:11px; color:var(--dim); margin-top:3px; font-family:'IBM Plex Mono',monospace; }
.pct { font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums; }
.pct.hot { color:var(--alarm); } .pct.warm { color:var(--amber); }

.msg { padding:5px 10px; margin-bottom:3px; font-size:12px; border-left:2px solid var(--amber);
       background:rgba(212,160,74,.06); }
.msg.bad { border-left-color:var(--alarm); background:rgba(207,96,88,.06); }
details.msgs > summary { cursor:pointer; font-size:12px; color:var(--dim); padding:4px 0; list-style:none; }
details.msgs > summary::before { content:'▸ '; color:var(--amber); }
details.msgs[open] > summary::before { content:'▾ '; }
.empty { padding:56px 14px; color:var(--dim); text-align:center; }

@media (prefers-reduced-motion:reduce) { * { transition:none !important; animation:none !important; } }

/* ── Адаптивность ─────────────────────────────────────────────
   Порядок жертв: сначала уходят справочные индикаторы, потом
   второстепенные колонки таблицы, и только в последнюю очередь
   меняется структура. Кнопки не прячутся никогда. */

/* Широкий ноутбук: убираем возраст справочных данных — он нужен редко. */
@media (max-width:1400px) { #chipData { display:none; } }

/* Узкий ноутбук: подпись бренда и версия уходят. */
@media (max-width:1150px) {
  .brand small { display:none; }
  #chipVer { display:none; }
  .modal-body .rows, .modal-body dl { grid-template-columns:1fr; }
  .modal-body .rows > div:nth-child(odd) { padding-bottom:0; border-bottom:none; }
}

/* Планшет: рейка настроек становится верхней панелью, таблица
   прокручивается горизонтально внутри своей области. */
@media (max-width:980px) {
  .split { grid-template-columns:1fr; }
  .rail { border-right:none; border-bottom:1px solid var(--seam); }
  .crew { max-height:150px; }
  main { overflow-x:auto; }
  table { min-width:840px; }
}

/* Телефон: круги мельче, полоса структур переносится,
   строка колонии выстраивается в столбец. */
@media (max-width:680px) {
  body { font-size:12px; }
  .topbar { padding:6px 10px; }
  .brand { margin-right:8px; }
  .tab { padding:9px 10px; }
  .answers { grid-template-columns:1fr 1fr; }
  .answer { border-right:none; border-bottom:1px solid var(--seam); }
  .colony { padding:10px; }
  .colony-head { flex-wrap:wrap; }
  .colony-head .tail { margin-left:0; text-align:left; width:100%; }
  .details-btn { margin-left:0; }
  .strip { gap:6px; }
  .grid { gap:8px; padding:10px; }
  .unit { flex-direction:column; gap:8px; padding:0 10px 8px; }
  .unit .cols2 { grid-template-columns:1fr; }
  .pilot-row .who { width:auto; }
  .modal { padding:0; }
  .modal-box { max-height:100vh; width:100%; }
}

@media (max-width:460px) {
  .answers { grid-template-columns:1fr; }
  .sso { padding:5px 9px; }
}

/* ── Верхняя панель: индикаторы и кнопки ─────────────────────── */
.topbar .info { display:flex; gap:6px; align-items:center; margin-left:18px; flex:0 0 auto; }
.topbar .right { margin-left:auto; display:flex; gap:6px; align-items:center; flex:0 0 auto; }
.chip { display:inline-flex; align-items:center; gap:7px; padding:4px 10px;
        border:1px solid var(--seam); background:var(--void); font-size:12px;
        color:var(--dim); white-space:nowrap; }
.chip b { color:var(--read); font-weight:500; font-family:'IBM Plex Mono',monospace; }
.chip .dot { width:7px; height:7px; border-radius:50%; background:#3d4956; flex:0 0 auto; }
.chip .dot.live { background:var(--calm); box-shadow:0 0 6px var(--calm); }
.chip .dot.stale { background:var(--amber); }
.tbtn { background:none; border:1px solid var(--seam); color:var(--read); padding:5px 12px;
        cursor:pointer; font-size:12px; white-space:nowrap; }
.tbtn:hover { border-color:var(--flux); color:var(--flux); }
.lang { display:inline-flex; border:1px solid var(--seam); }
.lang button { background:none; border:none; color:var(--dim); padding:5px 9px; cursor:pointer;
               font-size:12px; font-family:'IBM Plex Mono',monospace; }
.lang button.on { background:var(--seam); color:var(--bright); }
.icon-btn { background:none; border:1px solid var(--seam); color:var(--dim); width:30px; height:28px;
            display:inline-grid; place-items:center; cursor:pointer; }
.icon-btn:hover { color:var(--amber); border-color:var(--amber); }
.icon-btn svg { width:15px; height:15px; }
.sso { background:none; border:1px solid #2b3a4d; color:var(--flux); padding:5px 14px;
       cursor:pointer; font-size:12px; white-space:nowrap; }
.sso:hover { background:rgba(79,156,214,.1); }

/* ── Всплывающие окна ────────────────────────────────────────── */
.modal { position:fixed; inset:0; background:rgba(4,6,10,.7); display:none;
         z-index:100; align-items:center; justify-content:center; padding:24px; }
.modal.on { display:flex; }
.modal-box { background:var(--hull); border:1px solid var(--seam); width:min(880px,100%);
             max-height:86vh; display:flex; flex-direction:column; }
.modal-head { display:flex; align-items:center; padding:14px 18px; border-bottom:1px solid var(--seam); }
.modal-head h2 { margin:0; font-size:13px; letter-spacing:.1em; text-transform:uppercase;
                 color:var(--bright); font-weight:600; }
.modal-head .x { margin-left:auto; background:none; border:1px solid var(--seam); color:var(--dim);
                 width:28px; height:28px; cursor:pointer; font-size:15px; line-height:1; }
.modal-head .x:hover { color:var(--read); border-color:var(--read); }
.modal-body { overflow-y:auto; padding:18px; }
.modal-body h3 { font-size:12px; letter-spacing:.09em; text-transform:uppercase; color:var(--flux);
                 font-weight:600; margin:22px 0 8px; }
.modal-body h3:first-child { margin-top:0; }
.modal-body p { margin:0 0 10px; max-width:74ch; }
.modal-body ol, .modal-body ul { margin:0 0 10px; padding-left:22px; max-width:74ch; }
.modal-body li { margin-bottom:6px; }
.modal-body dl { display:grid; grid-template-columns:170px 1fr; gap:8px 18px; margin:0; }
.modal-body dt { color:var(--read); font-weight:500; }
.modal-body dd { margin:0; color:var(--dim); }
.modal-body a { color:var(--flux); }
.modal-body .rows { display:grid; grid-template-columns:220px 1fr; }
.modal-body .rows > div { padding:8px 0; border-bottom:1px solid var(--seam); }
.modal-body .rows > div:nth-child(odd) { color:var(--read); font-weight:500; padding-right:16px; }
.modal-body .rows > div:nth-child(even) { color:var(--dim); }

/* ── Списки множественного выбора ─────────────────────────────
   Обычный <select multiple> для этой задачи плох: выбор делается
   ctrl+кликом, случайный клик сбрасывает всё, иконок нет и не видно,
   что уже отмечено. Заменён на список флажков. */
.picker { border:1px solid var(--seam); background:var(--void); }
.picker-bar { display:flex; gap:6px; align-items:center; padding:6px 8px;
              border-bottom:1px solid var(--seam); }
.picker-bar input[type=search] { flex:1; min-width:0; background:var(--hull);
  border:1px solid var(--seam); color:var(--read); padding:4px 7px; font-size:12px;
  font-family:'IBM Plex Sans',sans-serif; }
.picker-bar input[type=search]:focus { outline:none; border-color:var(--flux); }
.mini { background:none; border:1px solid var(--seam); color:var(--dim); padding:3px 8px;
        cursor:pointer; font-size:11px; white-space:nowrap; }
.mini:hover { color:var(--flux); border-color:var(--flux); }
.picker-list { max-height:220px; overflow-y:auto; }
.picker-list label { display:flex; align-items:center; gap:8px; padding:4px 8px;
                     cursor:pointer; font-size:12px; }
.picker-list label:hover { background:var(--hull); }
/* Правило .field input задаёт width:100% для полей формы и распространяется
   на флажки внутри списка — они растягиваются на всю строку и выталкивают
   подпись за её пределы. Сбрасываем ширину явно. */
.picker-list input[type=checkbox] { width:auto; min-width:0; margin:0;
                                    accent-color:var(--flux); flex:0 0 auto; }
.picker-list img { width:20px; height:20px; object-fit:contain; flex:0 0 auto; }
.picker-list .tier { margin-left:auto; color:var(--dim); font-size:10px;
                     font-family:'IBM Plex Mono',monospace; }
.picker-list .cnt { margin-left:auto; color:var(--dim); font-size:11px;
                    font-family:'IBM Plex Mono',monospace; }
.picker-list .group-title { padding:5px 8px; font-size:10px; letter-spacing:.08em;
  text-transform:uppercase; color:var(--dim); background:var(--hull);
  border-top:1px solid var(--seam); }
.chosen { display:flex; flex-wrap:wrap; gap:4px; padding:6px 8px; border-top:1px solid var(--seam); }
.chosen span { background:var(--hull); border:1px solid var(--seam); padding:2px 7px;
               font-size:11px; display:inline-flex; align-items:center; gap:5px; }
.chosen b { cursor:pointer; color:var(--dim); font-weight:400; }
.chosen b:hover { color:var(--alarm); }
.chosen .none { color:var(--dim); border:none; background:none; padding:2px 0; }

/* ── Список закупки командных центров ────────────────────────── */
.shop { border-top:1px solid var(--seam); padding:14px; }
.shop h3 { font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--dim);
           font-weight:500; margin:0 0 10px; }
.shop-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:10px; }
.shop-item { display:flex; align-items:center; gap:10px; padding:9px 11px;
             border:1px solid var(--seam); background:var(--hull); }
.shop-item img { width:30px; height:30px; object-fit:contain; flex:0 0 auto; }
.shop-item .n { font-size:12px; color:var(--read); }
.shop-item .q { margin-left:auto; font-family:'IBM Plex Mono',monospace;
                font-size:16px; color:var(--bright); }
.shop-total { margin-top:10px; color:var(--dim); font-size:12px; }
</style>
</head>
<body>

<div class="topbar">
  <div class="brand">PI Director<small data-i18n="brandSub">планировщик колоний</small></div>
  <button class="tab on" data-page="dash" data-i18n="tabDash">Дашборд</button>
  <button class="tab" data-page="setup" data-i18n="tabSetup">Настройки</button>

  <div class="info">
    <span class="chip" id="chipEsi" title=""><span class="dot"></span><span>ESI</span><b id="esiPlayers">—</b></span>
    <span class="chip" id="chipData"><span data-i18n="chipData">данные</span><b id="dataStatus">—</b></span>
    <span class="chip" id="chipVer">v<b id="appVersion">—</b></span>
  </div>

  <div class="right">
    <button class="tbtn" onclick="openModal('help')" data-i18n="help">Справка</button>
    <button class="tbtn" onclick="openModal('about')" data-i18n="about">О проекте</button>
    <div class="lang">
      <button data-lang="ru" class="on">RU</button><button data-lang="en">EN</button>
    </div>
    <button class="icon-btn" id="themeBtn" onclick="toggleTheme()" title="Тема">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <circle cx="12" cy="12" r="4.2"/>
        <path d="M12 2v2.6M12 19.4V22M2 12h2.6M19.4 12H22M4.9 4.9l1.9 1.9M17.2 17.2l1.9 1.9M19.1 4.9l-1.9 1.9M6.8 17.2l-1.9 1.9"/>
      </svg>
    </button>
    <button class="sso" onclick="startLogin()" data-i18n="sso">Войти через EVE SSO</button>
  </div>
</div>

<div class="modal" id="modal" onclick="if(event.target===this)closeModal()">
  <div class="modal-box">
    <div class="modal-head">
      <h2 id="modalTitle"></h2>
      <button class="x" onclick="closeModal()">×</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
  </div>
</div>

<!-- ═══ ДАШБОРД ═══════════════════════════════════════════════════ -->
<div class="page on" id="page-dash">
  <div class="tools">
    <button class="tool on" data-view="details" title="Детали">
      <svg viewBox="0 0 16 16" fill="currentColor"><rect y="2" width="16" height="2"/><rect y="7" width="16" height="2"/><rect y="12" width="16" height="2"/></svg>
    </button>
    <button class="tool" data-view="list" title="Список по персонажам">
      <svg viewBox="0 0 16 16" fill="currentColor"><rect y="2" width="3" height="2"/><rect x="5" y="2" width="11" height="2"/><rect y="7" width="3" height="2"/><rect x="5" y="7" width="11" height="2"/><rect y="12" width="3" height="2"/><rect x="5" y="12" width="11" height="2"/></svg>
    </button>
    <button class="tool" data-view="grid" title="Сетка">
      <svg viewBox="0 0 16 16" fill="currentColor"><rect width="6" height="6"/><rect x="10" width="6" height="6"/><rect y="10" width="6" height="6"/><rect x="10" y="10" width="6" height="6"/></svg>
    </button>
    <div class="menu" id="sortMenu" style="margin-left:8px">
      <button class="tool" onclick="document.getElementById('sortMenu').classList.toggle('open')" title="Сортировка">
        <svg viewBox="0 0 16 16" fill="currentColor"><rect y="2" width="14" height="2"/><rect y="7" width="10" height="2"/><rect y="12" width="6" height="2"/></svg>
      </button>
      <div class="menu-pop" id="sortPop"></div>
    </div>
    <button class="mini" id="exportBtn" onclick="exportPlan()" style="margin-left:10px"
            data-i18n="export">Экспорт в Excel</button>
    <div class="counts" id="counts">план не построен</div>
  </div>
  <div id="dashBody"><div class="empty">План не построен. Откройте вкладку «Настройки», выберите продукты и постройте план.</div></div>
  <div id="shopping"></div>
  <div class="colony-page" id="colonyPage"></div>
</div>

<!-- ═══ НАСТРОЙКИ ═════════════════════════════════════════════════ -->
<div class="page" id="page-setup">
  <div class="answers" id="answers"></div>
  <div class="split">
    <aside class="rail">
      <h2 data-i18n="whatProduce">Что производим</h2>
      <div class="field">
        <label data-i18n="targets">Целевые продукты</label>
        <div class="picker">
          <div class="picker-bar">
            <input type="search" id="prodSearch" placeholder="поиск…" oninput="renderProducts()">
            <button class="mini" onclick="clearPick('products')" data-i18n="clearAll">Снять всё</button>
          </div>
          <div class="picker-list" id="productList"></div>
          <div class="chosen" id="productChosen"></div>
        </div>
      </div>

      <h2 data-i18n="whereMine">Где добываем</h2>
      <div class="field">
        <label data-i18n="constellations">Созвездия</label>
        <div class="picker">
          <div class="picker-bar">
            <button class="mini" onclick="pickAllConstellations()" data-i18n="wholeRegion">Весь регион</button>
            <button class="mini" onclick="clearPick('constellations')" data-i18n="clearAll">Снять всё</button>
          </div>
          <div class="picker-list" id="constList"></div>
          <div class="chosen" id="constChosen"></div>
        </div>
      </div>
      <div class="field">
        <label for="margin" data-i18n="margin">Запас на истощение месторождений</label>
        <input id="margin" type="number" value="1.0" step="0.1" min="1" max="3">
      </div>

      <h2 data-i18n="whereProcess">Где перерабатываем</h2>
      <div class="field">
        <label for="factorySys" data-i18n="homeSystem">Домашняя система</label>
        <select id="factorySys"></select>
      </div>
      <div class="field" id="thresholdNote" style="font-size:11px;color:var(--dim)"></div>

      <h2 data-i18n="crew">Персонажи</h2>
      <div class="crew" id="crew"><div style="color:var(--dim);font-size:12px">
        Появятся после расчёта: планировщик сам распределяет персонажей
        по планетам с учётом их прокачки.</div></div>

      <button class="run" onclick="calculate()" data-i18n="build">Построить план</button>
    </aside>

    <main>
      <div id="messages" style="padding:12px 14px 0"></div>
      <div id="tableWrap"><div class="empty">План не построен.</div></div>
    </main>
  </div>
</div>



<script>
const FLASK='http://127.0.0.1:8000';
const SAME=location.origin===FLASK||location.origin==='http://localhost:8000';
const API=SAME?'/api':`${FLASK}/api`;
const ICON=id=>`https://images.evetech.net/types/${id}/icon?size=64`;

let ids={}, plan=[], staffing={}, view='details', sortBy='load';
let lang='ru', crew=[], meta={};
let regions={}, systemCounts={}, allProducts=[], allConstellations=[];
const chosen={products:new Set(), constellations:new Set()};

/* ── Двуязычие ────────────────────────────────────────────────────
   Настройки живут на сервере? Нет: язык и тема — это предпочтения
   отображения, они принадлежат браузеру и хранятся локально.
   Персонажи, наоборот, живут на сервере — поэтому не пропадают при
   перезаходе и не зависят от очистки кэша. */
const T={
 ru:{brandSub:'планировщик колоний',tabDash:'Дашборд',tabSetup:'Настройки',
  chipData:'данные',help:'Справка',about:'О проекте',sso:'Войти через EVE SSO',
  online:'в игре',offline:'нет связи',noData:'нет данных',
  whatProduce:'Что производим',targets:'Целевые продукты',whereMine:'Где добываем',
  constellations:'Созвездия',margin:'Запас на истощение месторождений',
  whereProcess:'Где перерабатываем',homeSystem:'Домашняя система',crew:'Персонажи',
  build:'Построить план',noPlan:'План не построен. Откройте вкладку «Настройки».',
  colonies:'колоний',mining:'добыча',processing:'переработка',
  load:'Загрузка',details:'Детали',back:'Назад',reserveOk:'запас везде есть',
  noReserve:'без запаса',sortLoad:'По загрузке',sortReserve:'По остатку запаса',
  sortPilot:'По имени персонажа',sortSystem:'По системе',
  cProc:'переработка',cMine:'добыча',crewHint:'Персонажи хранятся на сервере и не пропадают при перезаходе.',
  planetSlots:'слотов планет',wholeRegion:'Весь регион',clearAll:'Снять всё',nothingChosen:'ничего не выбрано',systems:'систем',selectAll:'Выбрать все',pickProducts:'Выберите хотя бы один продукт',pickConst:'Выберите хотя бы одно созвездие',export:'Экспорт в Excel',shopping:'Список закупки: командные центры',shopTotal:'Всего командных центров',exportEmpty:'Сначала постройте план',exportFail:'Не удалось выгрузить файл'},
 en:{brandSub:'colony planner',tabDash:'Dashboard',tabSetup:'Settings',
  chipData:'data',help:'Help',about:'About',sso:'Log in with EVE SSO',
  online:'online',offline:'offline',noData:'no data',
  whatProduce:'What to produce',targets:'Target products',whereMine:'Where to extract',
  constellations:'Constellations',margin:'Depletion safety margin',
  whereProcess:'Where to process',homeSystem:'Home system',crew:'Characters',
  build:'Build plan',noPlan:'No plan yet. Open the Settings tab.',
  colonies:'colonies',mining:'extraction',processing:'processing',
  load:'Load',details:'Details',back:'Back',reserveOk:'headroom everywhere',
  noReserve:'no headroom',sortLoad:'By load',sortReserve:'By remaining headroom',
  sortPilot:'By character name',sortSystem:'By system',
  cProc:'processing',cMine:'extraction',crewHint:'Characters live on the server and survive a reload.',
  planetSlots:'planet slots',wholeRegion:'Whole region',clearAll:'Clear all',nothingChosen:'nothing selected',systems:'systems',selectAll:'Select all',pickProducts:'Select at least one product',pickConst:'Select at least one constellation',export:'Export to Excel',shopping:'Shopping list: command centres',shopTotal:'Command centres in total',exportEmpty:'Build a plan first',exportFail:'Export failed'}
};
const t=k=>(T[lang]||T.ru)[k]||k;

/* Доступ к localStorage может быть запрещён: приватный режим, отключённые
   cookie, открытие страницы как файла. Необёрнутое обращение выбрасывает
   исключение и роняет весь скрипт — приложение выглядит нерабочим.
   Настройки при этом не сохранятся, но всё остальное продолжит работать. */
const store={
  get(k,fallback){ try{ return localStorage.getItem(k) ?? fallback; }catch(e){ return fallback; } },
  set(k,v){ try{ localStorage.setItem(k,v); }catch(e){ /* сохранять некуда — не беда */ } }
};

function applyLang(){
  document.documentElement.lang=lang;
  document.querySelectorAll('[data-i18n]').forEach(el=>el.textContent=t(el.dataset.i18n));
  document.querySelectorAll('.lang button').forEach(b=>b.classList.toggle('on',b.dataset.lang===lang));
  store.set('pi-lang',lang);
  buildSortMenu(); renderCrew(); renderDash(); renderShopping();
  if(allProducts.length){ renderProducts(); renderConstellations(); } if(plan.length){renderAnswers(); renderTable();}
  if(document.getElementById('modal').classList.contains('on')) openModal(currentModal);
}

/* ── Тема ──────────────────────────────────────────────────────── */
function toggleTheme(){ setTheme(document.body.classList.contains('light')?'dark':'light'); }
function setTheme(name){
  const root=document.documentElement;
  root.classList.add('theme-switching');
  document.body.classList.toggle('light',name==='light');
  // Форсируем пересчёт, пока переходы выключены: иначе браузер
  // объединит добавление и снятие класса в один кадр.
  void document.body.offsetWidth;
  requestAnimationFrame(()=>requestAnimationFrame(()=>root.classList.remove('theme-switching')));
  store.set('pi-theme',name);
}

const STRUCT_RU={command_center:'Командный центр',launchpad:'Причал',storage_facility:'Склад',
  extractor_control_unit:'Экстрактор',basic_industry_facility:'Базовая фабрика',
  advanced_industry_facility:'Продвинутая фабрика',high_tech_industry_facility:'Высокотехнологичная фабрика'};
const RING={command_center:'--ring-infra',launchpad:'--ring-infra',storage_facility:'--ring-infra',
  extractor_control_unit:'--ring-extract',basic_industry_facility:'--ring-basic',
  advanced_industry_facility:'--ring-adv',high_tech_industry_facility:'--ring-adv'};

const SORTS=[{key:'load',t:'sortLoad'},{key:'reserve',t:'sortReserve'},
             {key:'pilot',t:'sortPilot'},{key:'system',t:'sortSystem'}];
function buildSortMenu(){
  const pop=document.getElementById('sortPop'); if(!pop) return;
  pop.innerHTML=SORTS.map(x=>`<button onclick="setSort('${x.key}')">
    <span class="mark">${x.key===sortBy?'✓':''}</span>${t(x.t)}</button>`).join('');
}

function initials(name){
  return String(name||'').split(/\s+/).filter(Boolean).slice(0,2)
    .map(w=>w[0].toUpperCase()).join('');
}

function plural(n,one,few,many){const a=Math.abs(n)%100,b=a%10;
  if(a>10&&a<20)return `${n} ${many}`; if(b>1&&b<5)return `${n} ${few}`;
  if(b===1)return `${n} ${one}`; return `${n} ${many}`;}

/* ── Круг колонии ───────────────────────────────────────────────
   Кольцо показывает загрузку по узкому ресурсу, а не таймер цикла:
   таймеров у нас пока нет, и рисовать вымышленное время нельзя. */
function orb(row,size){
  const peak=Math.max(row.cpu_percent,row.pg_percent);
  const r=(size/2)-2, c=2*Math.PI*r;
  const color=peak>=95?'var(--alarm)':peak>=90?'var(--amber)':
              (row.role.includes('Добыча')?'var(--ring-extract)':'var(--ring-adv)');
  const planetId=ids['planet:'+row.planet_type], cargoId=row.type_id;
  return `<div class="orb" style="--orb:${size}px" onclick="openColony('${row.id}')"
            title="${row.character} · ${row.system} ${row.planet} · ${row.res_out}">
    <div class="disc">${planetId?`<img src="${ICON(planetId)}" alt="">`:''}</div>
    ${cargoId?`<img class="cargo" src="${ICON(cargoId)}" alt="">`:''}
    <div class="arrows"><svg viewBox="0 0 40 40">
      <path d="M20 4 v9 M16 8 l4-4 4 4"/><path d="M20 36 v-9 M16 32 l4 4 4-4"/>
      <path d="M4 20 h9 M8 16 l-4 4 4 4"/><path d="M36 20 h-9 M32 16 l4 4-4 4"/>
    </svg></div>
    <svg class="ring" viewBox="0 0 ${size} ${size}">
      <circle class="track" cx="${size/2}" cy="${size/2}" r="${r}"/>
      <circle cx="${size/2}" cy="${size/2}" r="${r}" stroke="${color}"
        stroke-dasharray="${c*Math.min(peak,100)/100} ${c}" stroke-linecap="round"/>
    </svg>
    <div class="badge${peak>=95?' hot':''}">${peak.toFixed(0)}%</div>
    <div class="pilot" title="${row.character}">${initials(row.character)}</div>
  </div>`;
}

/* Маленький круг структуры внутри колонии. */
function structOrb(kind,count,planetType,opts){
  opts=opts||{};
  const id = kind==='command_center' ? ids[`${planetType} Command Center`] : ids['structure:'+kind];
  const size=opts.size||46, R=(size/2)-2, r2=R-5;
  const cOut=2*Math.PI*R, cIn=2*Math.PI*r2;

  // Командный центр показывает две нагрузки сразу: CPU бирюзовым слева,
  // Power красным справа — как в игре. Штриховка делает их различимыми
  // даже когда обе почти полные.
  let outer;
  if(kind==='command_center' && opts.cpu!=null){
    const half=cOut/2;
    outer=`<circle cx="${size/2}" cy="${size/2}" r="${R}" stroke="var(--ring-extract)"
             stroke-dasharray="${half*opts.cpu/100} ${cOut}" stroke-width="2.5"/>
           <circle cx="${size/2}" cy="${size/2}" r="${R}" stroke="var(--alarm)"
             stroke-dasharray="0 ${half} ${half*opts.pg/100} ${cOut}" stroke-width="2.5"/>`;
  } else {
    outer=`<circle class="outer" cx="${size/2}" cy="${size/2}" r="${R}"
             stroke="var(${RING[kind]})" stroke-dasharray="${cOut} ${cOut}" stroke-width="2.5"/>`;
  }

  // Внутреннее кольцо — ход производственного цикла. Данных о нём у нас
  // пока нет, поэтому по умолчанию оно пунктирное: «неизвестно».
  // Когда sync_colony_status начнёт отдавать таймеры, сюда придёт число,
  // и то же кольцо станет показывать реальный прогресс.
  const cyc = opts.cycle;
  const inner = cyc==null
    ? `<circle class="cycle none" cx="${size/2}" cy="${size/2}" r="${r2}" stroke-dasharray="2 4"/>`
    : `<circle class="cycle" cx="${size/2}" cy="${size/2}" r="${r2}"
         stroke-dasharray="${cIn*cyc/100} ${cIn}" stroke-linecap="round"/>`;

  return `<div class="orb${cyc!=null?' busy':''}" style="--orb:${size}px;cursor:default"
       title="${STRUCT_RU[kind]}${count>1?' ×'+count:''}${kind==='command_center'?' ('+planetType+')':''}">
    <div class="disc" style="background:#0d131b">${id?`<img src="${ICON(id)}" style="width:58%;height:58%;object-fit:contain">`:''}</div>
    <svg class="ring" viewBox="0 0 ${size} ${size}">
      <circle class="track" cx="${size/2}" cy="${size/2}" r="${R}"/>
      ${outer}${inner}
    </svg>
    ${count>1?`<div class="badge">×${count}</div>`:''}</div>`;
}

function secColor(t){ // цвет статуса безопасности как в игре
  return t==='Barren'||t==='Temperate' ? '#5b8a5b' : '#8a5b5b';
}

function sorted(){
  const c=[...plan];
  if(sortBy==='load')    c.sort((a,b)=>Math.max(b.cpu_percent,b.pg_percent)-Math.max(a.cpu_percent,a.pg_percent));
  if(sortBy==='reserve') c.sort((a,b)=>Math.max(a.cpu_percent,a.pg_percent)-Math.max(b.cpu_percent,b.pg_percent));
  if(sortBy==='pilot')   c.sort((a,b)=>a.character.localeCompare(b.character)||a.system.localeCompare(b.system));
  if(sortBy==='system')  c.sort((a,b)=>a.system.localeCompare(b.system)||(+a.planet)-(+b.planet));
  return c;
}

function renderDash(){
  const box=document.getElementById('dashBody');
  if(!plan.length){ box.innerHTML='<div class="empty">План не построен. Откройте вкладку «Настройки».</div>'; return; }
  const rows=sorted();

  if(view==='details'){
    box.innerHTML=rows.map(p=>{
      const peak=Math.max(p.cpu_percent,p.pg_percent);
      return `<div class="colony">
        <div class="colony-head">
          ${orb(p,54)}
          <div class="pilot-lg" title="${p.character}">${initials(p.character)}</div>
          <div>
            <div class="pilot-name">${p.character}</div>
            <div class="sub">
              <span>${p.role}</span>
              <span class="sysbadge">${p.system} ${p.planet}</span>
              <span class="sec" style="color:${secColor(p.planet_type)}">${p.planet_type}</span>
              <span class="num">${Math.round(p.planet_radius_km).toLocaleString('ru')} км</span>
            </div>
          </div>
          <div class="tail">
            <div class="lbl">Загрузка</div>
            <div class="val${peak>=90?' hot':''}">CPU ${p.cpu_percent.toFixed(1)}% · PG ${p.pg_percent.toFixed(1)}%</div>
          </div>
          <button class="details-btn" onclick="openColony('${p.id}')">Детали</button>
        </div>
        <div class="strip">${expandStructures(p).map(kind=>structOrb(kind,1,p.planet_type,
              kind==="command_center"?{cpu:p.cpu_percent,pg:p.pg_percent}:{})).join('')}</div>
      </div>`;
    }).join('');
  }

  if(view==='list'){
    const byPilot={};
    rows.forEach(p=>(byPilot[p.character]=byPilot[p.character]||[]).push(p));
    box.innerHTML=Object.entries(byPilot).map(([name,items])=>`
      <div class="pilot-row">
        <div class="who">
          <div class="pilot-lg" style="margin-bottom:4px">${initials(name)}</div>
          <div class="pilot-name" style="font-size:12px">${name}</div>
          <div class="sub" style="font-size:11px">${plural(items.length,'колония','колонии','колоний')}</div>
        </div>
        <div class="orbs">${items.map(p=>orb(p,52)).join('')}</div>
      </div>`).join('');
  }

  if(view==='grid'){
    box.innerHTML=`<div class="grid">${rows.map(p=>orb(p,58)).join('')}</div>`;
  }

  const strained=plan.filter(p=>Math.max(p.cpu_percent,p.pg_percent)>=90).length;
  document.getElementById('counts').innerHTML=
    `<b>${plural(plan.length,'колония','колонии','колоний')}</b>`
    + (strained?` · <span class="idle">${strained} без запаса</span>`:' · запас везде есть');
}

/* Разворачивает состав в поштучный список: 24 фабрики — это 24 круга,
   а не один со значком «×24». Так устроено игровое окно, и так видно
   каждый производственный модуль по отдельности. Полоса переносится
   на следующую строку сама (flex-wrap), поэтому при сужении окна
   круги просто перестраиваются. */
function expandStructures(p){
  const out=[];
  (p.structures_detail||[]).forEach(s=>{ for(let i=0;i<s.count;i++) out.push(s.kind); });
  return out;
}

/* ── Список закупки ──────────────────────────────────────────
   Считается по типам планет: командный центр покупается под тип,
   и в игре это отдельный предмет с собственным type_id. */
function renderShopping(){
  const box=document.getElementById('shopping');
  if(!plan.length){ box.innerHTML=''; return; }
  const byType={};
  plan.forEach(p=>{ byType[p.planet_type]=(byType[p.planet_type]||0)+1; });
  const total=Object.values(byType).reduce((a,b)=>a+b,0);
  box.innerHTML=`<div class="shop">
    <h3>${t('shopping')}</h3>
    <div class="shop-grid">${Object.entries(byType).sort().map(([type,n])=>{
      const id=ids[`${type} Command Center`];
      return `<div class="shop-item">
        ${id?`<img src="${ICON(id)}" alt="">`:'<span style="width:30px"></span>'}
        <span class="n">${type}</span><span class="q">${n}</span></div>`;
    }).join('')}</div>
    <div class="shop-total">${t('shopTotal')}: ${total}</div>
  </div>`;
}

/* ── Выгрузка в Excel ────────────────────────────────────────
   Файл собирает сервер (openpyxl), браузер только скачивает:
   так в книге остаются формулы, которые пересчитываются при правке. */
async function exportPlan(){
  if(!plan.length){ alert(t('exportEmpty')); return; }
  const btn=document.getElementById('exportBtn');
  btn.disabled=true;
  try{
    const r=await fetch(`${API}/export`,{method:'POST',
      headers:{'Content-Type':'application/json'},body:JSON.stringify({plan_data:plan})});
    if(!r.ok){
      const d=await r.json().catch(()=>({}));
      throw new Error(d.message||`HTTP ${r.status}`);
    }
    const blob=await r.blob();
    const url=URL.createObjectURL(blob), a=document.createElement('a');
    a.href=url;
    a.download=(r.headers.get('Content-Disposition')||'').match(/filename=([^;]+)/)?.[1]
      || `pi-plan.xlsx`;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
  }catch(e){ alert(`${t('exportFail')}: ${e.message}`); }
  finally{ btn.disabled=false; }
}

/* ── Панель колонии: разбор по структурам, как в игре ─────────── */
function openColony(id){
  const p=plan.find(x=>x.id===id); if(!p)return;
  const pgb=p.pg_breakdown||{};
  const planetId=ids['planet:'+p.planet_type];

  // Разворачиваем состав в отдельные строки: в игре каждая структура —
  // своя строка со своими показателями, а не одна плашка с числом.
  const units=[];
  (p.structures_detail||[]).forEach(sd=>{
    for(let i=0;i<sd.count;i++) units.push(sd.kind);
  });

  const body=units.map((kind,i)=>{
    const isFactory=kind.includes('industry_facility');
    const isCC=kind==='command_center';
    const isECU=kind==='extractor_control_unit';
    const isStore=kind==='launchpad'||kind==='storage_facility';
    const code=`${String.fromCharCode(65+(i%26))}${i}-${p.planet}`;

    let fields='';
    if(isCC){
      fields=`<div class="cols2">
        <div><div class="lbl">CPU: ${p.cpu_percent.toFixed(1)}%</div>
          <div class="meter"><i class="cpu" style="width:${Math.min(p.cpu_percent,100)}%"></i></div></div>
        <div><div class="lbl">Power: ${p.pg_percent.toFixed(1)}%</div>
          <div class="meter"><i class="pg${p.pg_percent<90?' ok':''}" style="width:${Math.min(p.pg_percent,100)}%"></i></div></div>
      </div>
      <div class="meta" style="margin-top:6px">
        Из чего сложилось (Power): структуры ${pgb.structures||0}% · головы ${pgb.heads||0}% · линки ${pgb.links||0}%</div>`;
    } else if(isStore){
      fields=`<div class="cols2">
        <div><div class="lbl">Вместимость</div>
          <div class="meter"><i class="ok" style="width:0%;background:var(--ring-infra)"></i></div>
          <div class="val">0 / ${kind==='launchpad'?'10 000':'12 000'} m³</div></div>
        <div><div class="lbl">Содержимое</div><div class="meta">нет данных</div></div>
      </div>`;
    } else if(isECU){
      fields=`<div class="cols2">
        <div><div class="lbl">Текущий цикл</div>
          <div class="meter"><i style="width:0%;background:var(--ring-extract)"></i></div>
          <div class="meta">данных о цикле нет</div></div>
        <div><div class="lbl">Добывает</div>
          <div class="val">${p.res_in||'—'}</div>
          <div class="meta">10 голов</div></div>
      </div>`;
    } else if(isFactory){
      const inputs=(p.res_in||'').split(',').map(x=>x.trim()).filter(Boolean);
      fields=`<div class="cols2">
        <div><div class="state-wait">Состояние цикла неизвестно</div>
          <div class="meter"><i style="width:0%"></i></div>
          <div class="meta">появится после подключения к игре</div></div>
        <div><div class="lbl">Производит</div>
          <div class="val">${p.res_out}</div>
          <div class="lbl" style="margin-top:5px">Вход</div>
          <div class="inputs">${inputs.map(n=>ids[n]
            ?`<span class="have" title="${n}"><img src="${ICON(ids[n])}" alt=""></span>`
            :`<span title="${n}">·</span>`).join('')}</div></div>
      </div>`;
    }

    return `<div class="unit">
      ${structOrb(kind,1,p.planet_type,isCC?{cpu:p.cpu_percent,pg:p.pg_percent,size:52}:{size:52})}
      <div class="panel">
        <div class="title">${STRUCT_RU[kind]} <span class="code">${code}</span></div>
        ${fields}
      </div>
    </div>`;
  }).join('');

  document.getElementById('colonyPage').innerHTML=`
    <div class="cp-head">
      ${orb(p,58)}
      <div>
        <div class="pilot-name">${p.character}</div>
        <div class="sub">
          <span class="sysbadge">${p.system} ${p.planet}</span>
          <span class="sec" style="color:${secColor(p.planet_type)}">${p.planet_type}</span>
          <span class="num">${Math.round(p.planet_radius_km).toLocaleString('ru')} км</span>
          <span>${p.role}</span>
        </div>
      </div>
      <button class="back" onclick="closeColony()">Назад</button>
    </div>
    ${(p.shared_extraction_count||1)>1?`<div class="msg" style="margin:0 16px 8px">
      На этой планете ${p.shared_extraction_count} наших экстрактора на одном сырье —
      выработка каждого будет ниже расчётной.</div>`:''}
    ${body}`;

  document.getElementById('dashBody').style.display='none';
  document.getElementById('shopping').style.display='none';
  document.querySelector('#page-dash .tools').style.display='none';
  document.getElementById('colonyPage').classList.add('on');
}

function closeColony(){
  document.getElementById('colonyPage').classList.remove('on');
  document.getElementById('dashBody').style.display='';
  document.getElementById('shopping').style.display='';
  document.querySelector('#page-dash .tools').style.display='';
}
document.addEventListener('keydown',e=>{ if(e.key==='Escape')closeColony(); });

/* ── Справка и «О проекте» ────────────────────────────────────── */
let currentModal=null;

const DOC={
 help:{
  ru:{title:'Справка',html:`
   <h3>Что считает планировщик</h3>
   <p>PI Director отвечает на один вопрос: сколько колоний и каких нужно, чтобы
   производить выбранные продукты непрерывно, и хватит ли на это ваших персонажей.</p>
   <p>Расчёт идёт сверху вниз: целевой продукт разворачивается до сырья через дерево
   рецептов, потребность в одинаковых компонентах складывается, затем число фабрик
   переводится в число шаблонов застройки и колоний.</p>

   <h3>Как пользоваться</h3>
   <ol>
    <li>На вкладке «Настройки» выберите целевые продукты. Можно несколько сразу —
    общие компоненты будут учтены один раз с суммарной потребностью.</li>
    <li>Отметьте созвездия, где добываете сырьё. Планеты подбираются по убыванию
    плотности ресурса.</li>
    <li>Выберите домашнюю систему для заводов. Переработка ставится только на планеты
    Barren и Temperate, по возрастанию радиуса: чем меньше планета, тем дешевле линки.</li>
    <li>При необходимости задайте запас на истощение месторождений. Это не расчёт,
    а поправка, которую вы подбираете по опыту.</li>
    <li>Нажмите «Построить план». Результат появится на дашборде.</li>
   </ol>

   <h3>Что показывает дашборд</h3>
   <div class="rows">
    <div>Кольцо колонии</div><div>Загрузка по узкому ресурсу: сколько процентов ёмкости
    командного центра занято. Красное — запаса почти нет.</div>
    <div>Командный центр</div><div>Двойное кольцо: бирюзовым CPU, красным Power.</div>
    <div>Кольца структур</div><div>Внешнее — тип структуры, внутреннее — ход
    производственного цикла. Пунктир означает, что данных о цикле нет.</div>
    <div>Полоса «из чего сложилось»</div><div>Разбивка нагрузки: структуры, головы
    экстрактора, линки. Большая доля линков означает слишком крупную планету.</div>
   </div>

   <h3>Чего программа пока не знает</h3>
   <p>Времени до конца цикла и остатков на складах: эти данные приходят из игры через
   ESI, а подключение к нему — следующий этап. Вместо выдуманных чисел показывается
   «нет данных»: правдоподобное, но ложное значение хуже честного пробела.</p>
   <p>Плотность сырья берётся из статического файла и считается постоянной. В игре
   месторождения истощаются, но живых данных об этом нет ни у кого, кроме самой игры.</p>`},
  en:{title:'Help',html:`
   <h3>What the planner computes</h3>
   <p>PI Director answers one question: how many colonies of which kind you need to
   produce the selected products continuously, and whether your characters suffice.</p>
   <p>It works top-down: the target product is expanded to raw materials through the
   recipe tree, demand for shared components is summed, then factory counts become
   template and colony counts.</p>

   <h3>How to use it</h3>
   <ol>
    <li>On the Settings tab pick your target products. Several at once is fine — shared
    components are counted once, with summed demand.</li>
    <li>Select the constellations you extract from. Planets are ranked by resource density.</li>
    <li>Pick a home system for the factories. Processing goes on Barren and Temperate
    planets only, smallest radius first: smaller planets make cheaper links.</li>
    <li>Optionally set a depletion safety margin. This is not a calculation but a
    correction you tune from experience.</li>
    <li>Press “Build plan”. The result appears on the Dashboard.</li>
   </ol>

   <h3>What the dashboard shows</h3>
   <div class="rows">
    <div>Colony ring</div><div>Load on the binding resource: how much command centre
    capacity is used. Red means almost no headroom.</div>
    <div>Command centre</div><div>Double ring: teal for CPU, red for Power.</div>
    <div>Structure rings</div><div>Outer ring is the structure type, inner one is cycle
    progress. A dashed inner ring means no cycle data.</div>
    <div>Composition bar</div><div>Load breakdown: structures, extractor heads, links.
    A large link share means the planet is too big.</div>
   </div>

   <h3>What the program does not know yet</h3>
   <p>Cycle timers and storage contents: that data comes from the game through ESI, and
   connecting to it is the next stage. Instead of invented numbers you see “no data” —
   a plausible but false value is worse than an honest gap.</p>
   <p>Resource density comes from a static file and is treated as constant. Deposits do
   deplete in game, but nobody outside the game has live data on that.</p>`}},

 about:{
  ru:{title:'О проекте',html:`
   <h3>Программа</h3>
   <p>PI Director — планировщик планетарного производства для EVE Online. Считает состав
   колоний, распределяет их по персонажам и показывает, где план упирается в ограничения.</p>
   <dl>
    <dt>Версия</dt><dd id="aboutVersion">—</dd>
    <dt>Этап</dt><dd id="aboutPhase">—</dd>
   </dl>

   <h3>Откуда данные</h3>
   <p>Все числовые константы взяты из проверенных источников и сверены между собой:
   игровые JSON-шаблоны застройки, справочник eve-webtools.com и вики EVE University.
   Полная сверка 68 продуктов с вики дала ноль расхождений.</p>
   <p>При споре о составе продукта приоритет у шаблонов застройки: их маршруты ссылаются
   на игровые type_id, а не на названия, в которых встречаются опечатки.</p>

   <h3>Обращения к игре</h3>
   <p>Приложение не обращается к ESI по действию пользователя. Всё, что требует сети,
   собирают фоновые скрипты по расписанию, а страницы читают готовые снимки. Это защищает
   от исчерпания лимитов при большом числе пользователей.</p>

   <h3>Права</h3>
   <p>EVE Online и логотип EVE — зарегистрированные торговые марки CCP hf. Все права на
   игру, включая изображения и материалы, принадлежат CCP hf. Приложение сделано
   независимо, CCP hf его не поддерживает и не одобряет.</p>`},
  en:{title:'About',html:`
   <h3>The program</h3>
   <p>PI Director is a planetary industry planner for EVE Online. It computes colony
   layouts, assigns them to characters and shows where the plan hits its limits.</p>
   <dl>
    <dt>Version</dt><dd id="aboutVersion">—</dd>
    <dt>Stage</dt><dd id="aboutPhase">—</dd>
   </dl>

   <h3>Where the data comes from</h3>
   <p>Every constant comes from verified sources cross-checked against each other: the
   game's own JSON colony templates, the eve-webtools.com reference and the EVE University
   wiki. A full comparison of all 68 products against the wiki found zero discrepancies.</p>
   <p>When sources disagree on a product's inputs, the colony templates win: their routes
   reference game type_ids rather than names, and names carry typos.</p>

   <h3>Calls to the game</h3>
   <p>The application never calls ESI in response to a user action. Everything that needs
   the network is collected by scheduled background scripts, and pages read finished
   snapshots. This keeps rate limits safe as the number of users grows.</p>

   <h3>Rights</h3>
   <p>EVE Online and the EVE logo are registered trademarks of CCP hf. All rights to the
   game, including imagery and materials, belong to CCP hf. This application is made
   independently and is neither endorsed nor sponsored by CCP hf.</p>`}}
};

function openModal(name){
  currentModal=name;
  const doc=DOC[name][lang]||DOC[name].ru;
  document.getElementById('modalTitle').textContent=doc.title;
  document.getElementById('modalBody').innerHTML=doc.html;
  const v=document.getElementById('aboutVersion'), ph=document.getElementById('aboutPhase');
  if(v) v.textContent=meta.version||'—';
  if(ph) ph.textContent=meta.phase||'—';
  document.getElementById('modal').classList.add('on');
}
function closeModal(){ document.getElementById('modal').classList.remove('on'); currentModal=null; }

/* ── Состояние сервера и персонажи ────────────────────────────── */
async function loadMeta(){
  try{
    const d=await (await fetch(`${API}/meta`)).json();
    meta=d;
    document.getElementById('appVersion').textContent=d.version||'—';
    const chip=document.getElementById('chipEsi'), dot=chip.querySelector('.dot');
    const sv=d.server||{};
    if(sv.available && sv.players!=null){
      dot.className='dot'+(sv.stale?' stale':' live');
      document.getElementById('esiPlayers').textContent=
        `${sv.players.toLocaleString('ru')} ${t('online')}`;
      chip.title=sv.stale?`Снимок сделан ${sv.age_minutes} мин назад`:'';
    } else {
      dot.className='dot';
      document.getElementById('esiPlayers').textContent=t('noData');
      chip.title=sv.hint||'';
    }
  }catch(e){ document.getElementById('esiPlayers').textContent=t('noData'); }
}

async function loadCrew(){
  try{
    const d=await (await fetch(`${API}/characters`)).json();
    crew=d.characters||[];
  }catch(e){ crew=[]; }
  renderCrew();
}

async function startLogin(){
  const r=await fetch(`${API}/auth/login-url`);
  const d=await r.json();
  if(d.status==='success' && d.url){ location.href=d.url; return; }
  alert(d.message||'Вход недоступен');
}

/* ── Настройки ──────────────────────────────────────────────── */
async function boot(){
  try{
    const res=await fetch(`${API}/initial-data`);
    if(!(res.headers.get('content-type')||'').includes('application/json'))
      throw new Error(`${API} вернул не JSON. Запустите «python run.py» и откройте ${FLASK}/`);
    const d=await res.json();
    ids=d.product_ids||{};
    allConstellations=d.bases||[];
    allProducts=d.products||[];
    regions=d.regions||{};
    systemCounts=d.system_counts||{};
    renderProducts(); renderConstellations();
    document.getElementById('dataStatus').textContent=
      `${plural((d.bases||[]).length,'созвездие','созвездия','созвездий')} · `
      +`${plural((d.products||[]).length,'продукт','продукта','продуктов')}`;
    (d.data_problems||[]).forEach(t=>msg(t,true));
  
  }catch(e){ msg(e.message,true); document.getElementById('dataStatus').textContent='не загружены'; }

  buildSortMenu();
}
function setSort(k){ sortBy=k; document.getElementById('sortMenu').classList.remove('open');
  buildSortMenu(); renderDash(); }

/* ── Списки выбора ────────────────────────────────────────────── */
function renderProducts(){
  const q=(document.getElementById('prodSearch').value||'').toLowerCase();
  const list=document.getElementById('productList');
  list.innerHTML=allProducts.filter(n=>n.toLowerCase().includes(q)).map(n=>{
    const id=ids[n];
    return `<label><input type="checkbox" ${chosen.products.has(n)?'checked':''}
        onchange="togglePick('products','${n.replace(/'/g,"\\'")}',this.checked)">
      ${id?`<img src="${ICON(id)}" alt="">`:'<span style="width:20px"></span>'}
      <span>${n}</span></label>`;
  }).join('')||`<div style="padding:8px;color:var(--dim);font-size:12px">—</div>`;
  renderChosen('products','productChosen');
}

function renderConstellations(){
  const list=document.getElementById('constList');
  const names=Object.keys(regions);
  // Если в выгрузке есть колонка Region — группируем по регионам
  // и даём выбрать регион целиком одним щелчком. Если колонки нет,
  // показываем плоский список: выдумывать группировку не из чего.
  let html='';
  if(names.length){
    names.forEach(r=>{
      const inR=regions[r];
      const all=inR.every(c=>chosen.constellations.has(c));
      html+=`<div class="group-title">${r}
        <button class="mini" style="float:right;margin-top:-2px"
          onclick="pickRegion('${r.replace(/'/g,"\\'")}',${!all})">
          ${all?t('clearAll'):t('selectAll')}</button></div>`;
      html+=inR.map(c=>constRow(c)).join('');
    });
  } else {
    html=allConstellations.map(c=>constRow(c)).join('');
  }
  list.innerHTML=html||`<div style="padding:8px;color:var(--dim);font-size:12px">—</div>`;
  renderChosen('constellations','constChosen');
}

function constRow(c){
  const n=systemCounts[c];
  return `<label><input type="checkbox" ${chosen.constellations.has(c)?'checked':''}
      onchange="togglePick('constellations','${c.replace(/'/g,"\\'")}',this.checked)">
    <span>${c}</span>${n?`<span class="cnt">${n} ${t('systems')}</span>`:''}</label>`;
}

function renderChosen(key,boxId){
  const box=document.getElementById(boxId); if(!box) return;
  const items=[...chosen[key]];
  box.innerHTML=items.length
    ? items.map(v=>`<span>${v}<b onclick="togglePick('${key}','${v.replace(/'/g,"\\'")}',false)">×</b></span>`).join('')
    : `<span class="none">${t('nothingChosen')}</span>`;
}

function togglePick(key,value,on){
  on?chosen[key].add(value):chosen[key].delete(value);
  key==='products'?renderProducts():renderConstellations();
  if(key==='constellations') loadSystems();
}
function clearPick(key){ chosen[key].clear();
  key==='products'?renderProducts():renderConstellations();
  if(key==='constellations') loadSystems(); }
function pickAllConstellations(){
  allConstellations.forEach(c=>chosen.constellations.add(c));
  renderConstellations(); loadSystems();
}
function pickRegion(name,on){
  (regions[name]||[]).forEach(c=>on?chosen.constellations.add(c):chosen.constellations.delete(c));
  renderConstellations(); loadSystems();
}

function fill(id,items){ document.getElementById(id).innerHTML=items.map(v=>`<option value="${v}">${v}</option>`).join(''); }
function picked(id){ return chosen[id] ? [...chosen[id]] : []; }
function msg(t,bad){ document.getElementById('messages').insertAdjacentHTML('beforeend',
  `<div class="msg${bad?' bad':''}">${t}</div>`); }

async function loadSystems(){
  const c=picked('constellations');
  if(!c.length){ fill('factorySys',[]); return; }
  const r=await fetch(`${API}/systems`,{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({constellations:c})});
  fill('factorySys',(await r.json()).systems||[]);
}

async function calculate(){
  if(!picked('products').length){ msg(t('pickProducts'),true); return; }
  if(!picked('constellations').length){ msg(t('pickConst'),true); return; }
  const body={constellations:picked('constellations'),
    factory_sys:document.getElementById('factorySys').value,
    target_products:picked('products'),
    extraction_margin:parseFloat(document.getElementById('margin').value)||1.0};
  document.getElementById('messages').innerHTML='';
  const r=await fetch(`${API}/calculate`,{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify(body)});
  const d=await r.json();
  if(d.status!=='success'){ msg(d.message,true); return; }

  plan=d.data||[]; staffing=d.staffing||{};
  renderMessages(d.warnings||[],d.assumptions||[]);
  renderAnswers(); renderTable(); renderDash(); renderCrew(); renderShopping();
  show('dash');
}

function renderMessages(warnings,assumptions){
  const box=document.getElementById('messages');
  const crit=warnings.filter(w=>w.includes('ДЕФИЦИТ'));
  const rest=warnings.filter(w=>!w.includes('ДЕФИЦИТ')).concat(assumptions);
  box.innerHTML=crit.map(w=>`<div class="msg bad">${w}</div>`).join('');
  if(rest.length) box.insertAdjacentHTML('beforeend',
    `<details class="msgs"><summary>${plural(rest.length,'замечание','замечания','замечаний')} к плану</summary>
     ${rest.map(w=>`<div class="msg">${w}</div>`).join('')}</details>`);
}

// Показываем ЗАЛОГИНЕННЫХ персонажей и их занятость по плану.
// Список приходит с сервера, поэтому переживает перезаход на сайт.
function renderCrew(){
  const box=document.getElementById('crew'); if(!box) return;
  if(!crew.length){
    box.innerHTML=`<div style="color:var(--dim);font-size:12px">${t('noData')}</div>`;
    return;
  }
  const busy={};
  plan.forEach(r=>{
    const c=busy[r.char_id]=busy[r.char_id]||{mine:0,proc:0};
    r.role.includes('Добыча')?c.mine++:c.proc++;
  });
  box.innerHTML=crew.map(c=>{
    const b=busy[c.id]||{mine:0,proc:0}, used=b.mine+b.proc;
    return `<div title="CCU ${c.ccu} · IC ${c.ic} · ${c.planet_slots} ${t('planetSlots')}">
      <div class="pilot-lg" style="width:22px;height:22px;font-size:9px">${initials(c.name)}</div>
      <span>${c.name}</span>
      <span class="lv">${used}/${c.planet_slots}</span></div>`;
  }).join('')
  + `<div style="color:var(--dim);font-size:11px;margin-top:8px">${t('crewHint')}</div>`;
}

function renderAnswers(){
  const mining=plan.filter(r=>r.role.includes('Добыча'));
  const worst=plan.reduce((w,r)=>Math.max(r.cpu_percent,r.pg_percent)>Math.max(w.cpu_percent||0,w.pg_percent||0)?r:w,{});
  const short=Object.values(staffing).reduce((n,s)=>n+(s.characters_needed||0),0);
  const cards=[
    {label:'Колоний в плане',value:plan.length,note:`${mining.length} добыча · ${plan.length-mining.length} переработка`},
    {label:'Персонажей занято',value:new Set(plan.map(r=>r.char_id)).size,
     note:`на ${plural(new Set(plan.map(r=>r.system+r.planet)).size,'планете','планетах','планетах')}`},
    {label:'Самая нагруженная',value:worst.pg_percent?Math.max(worst.cpu_percent,worst.pg_percent).toFixed(0):'—',
     unit:'%',warn:Math.max(worst.cpu_percent||0,worst.pg_percent||0)>=90,
     note:worst.system?`${worst.system} ${worst.planet}`:'нет данных'},
    {label:'Не хватает персонажей',value:short||'0',warn:short>0,
     note:short?Object.entries(staffing).map(([r,s])=>`${r}: CCU ${s.min_ccu_level}+`).join(' · '):'план закрыт'}
  ];
  document.getElementById('answers').innerHTML=cards.map(c=>`
    <div class="answer"><div class="label">${c.label}</div>
      <div class="value${c.warn?' warn':''}">${c.value}${c.unit?`<span class="unit-s">${c.unit}</span>`:''}</div>
      <div class="note">${c.note}</div></div>`).join('');
}

function renderTable(){
  if(!plan.length){ document.getElementById('tableWrap').innerHTML='<div class="empty">План пуст.</div>'; return; }
  const rows=[...plan].sort((a,b)=>Math.max(b.cpu_percent,b.pg_percent)-Math.max(a.cpu_percent,a.pg_percent));
  const body=rows.map((r,i)=>{
    const peak=Math.max(r.cpu_percent,r.pg_percent), reserve=100-peak, pgb=r.pg_breakdown||{};
    return `<tr>
      <td class="idx num">${i+1}</td>
      <td><div style="color:var(--bright)">${r.character}</div>
          <div class="parts" style="margin:0">${r.role}</div></td>
      <td><div class="num">${r.system} ${r.planet}</div>
          <div class="parts" style="margin:0">${r.planet_type} · ${Math.round(r.planet_radius_km).toLocaleString('ru')} км</div></td>
      <td>${r.res_out}<div class="parts" style="margin:0">${r.structures}${r.res_in?' ← '+r.res_in:''}</div></td>
      <td><div class="stack"><i class="s-str" style="width:${pgb.structures||0}%"></i>
          <i class="s-hed" style="width:${pgb.heads||0}%"></i>
          <i class="s-lnk" style="width:${pgb.links||0}%"></i></div>
          <div class="parts">структуры ${pgb.structures||0} · головы ${pgb.heads||0} · линки ${pgb.links||0}</div></td>
      <td class="r"><span class="pct ${r.cpu_percent>=90?'hot':r.cpu_percent>=75?'warm':''}">${r.cpu_percent.toFixed(1)}</span></td>
      <td class="r"><span class="pct ${r.pg_percent>=90?'hot':r.pg_percent>=75?'warm':''}">${r.pg_percent.toFixed(1)}</span></td>
      <td class="r"><span class="pct" style="color:${reserve<5?'var(--alarm)':reserve<15?'var(--amber)':'var(--calm)'}">${reserve.toFixed(1)}</span></td>
    </tr>`;}).join('');
  document.getElementById('tableWrap').innerHTML=`<table>
    <thead>
      <tr class="group"><th colspan="3">Колония<small>кто и где</small></th>
        <th>Производство<small>что делает и из чего</small></th>
        <th colspan="4">Нагрузка<small>из чего сложилась и сколько осталось</small></th></tr>
      <tr class="cols"><th>#</th><th>Персонаж</th><th>Планета</th><th>Продукт</th>
        <th>Из чего сложилось (PG)</th><th class="r">CPU %</th><th class="r">PG %</th><th class="r">Запас</th></tr>
    </thead><tbody>${body}</tbody></table>`;
}

/* Высота шапки меняется, когда она переносится на вторую строку,
   поэтому отступ для прилипающей панели вида измеряется, а не
   задаётся числом: иначе при переносе панель перекрыла бы шапку. */
function measureTopbar(){
  const h=document.querySelector('.topbar').offsetHeight;
  document.documentElement.style.setProperty('--topbar-h', h+'px');
}
if(window.ResizeObserver){
  new ResizeObserver(measureTopbar).observe(document.querySelector('.topbar'));
} else {
  window.addEventListener('resize', measureTopbar);
}

/* ── Вкладки и вид ──────────────────────────────────────────── */
function show(p){
  document.querySelectorAll('.page').forEach(x=>x.classList.toggle('on',x.id==='page-'+p));
  document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('on',x.dataset.page===p));
}
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>show(t.dataset.page));
document.querySelectorAll('.tool[data-view]').forEach(t=>t.onclick=()=>{
  view=t.dataset.view;
  document.querySelectorAll('.tool[data-view]').forEach(x=>x.classList.toggle('on',x===t));
  renderDash();
});
document.addEventListener('click',e=>{ if(!e.target.closest('#sortMenu'))
  document.getElementById('sortMenu').classList.remove('open'); });

document.querySelectorAll('.lang button').forEach(b=>b.onclick=()=>{ lang=b.dataset.lang; applyLang(); });
document.addEventListener('keydown',e=>{ if(e.key==='Escape')closeModal(); });

// Язык и тема — предпочтения отображения, они принадлежат браузеру.
setTheme(store.get('pi-theme','dark'));
lang=store.get('pi-lang','ru');

measureTopbar();
boot(); loadMeta(); loadCrew(); applyLang();
// Онлайн меняется медленно; снимок обновляет фоновый сборщик,
// поэтому опрашиваем раз в минуту и только читаем готовое.
setInterval(loadMeta, 60000);
</script>
</body>
</html>
