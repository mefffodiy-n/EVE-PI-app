# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Виртуальные окружения
.venv/
venv/

# Локальные базы данных (см. roadmap.md: pi_director.db не должен жить в git)
*.db
*.sqlite3

# Секреты/конфиг окружения
.env
.env.*

# IDE
.vscode/
.idea/
data/cache/*.json

# Claude Code — личные настройки и локальный конфиг дев-сервера.
# Общий .claude/settings.json (хуки/права для всех) можно коммитить —
# он не под шаблоном ниже.
.claude/settings.local.json
.claude/launch.json

# Генерируется локально из data/templates/ скриптом extract_schematics.
# В репозитории не нужен: собирается одной командой из шаблонов.
data/schematics.json

# Сохранённые планы — данные пользователя, не часть кода.
data/plans/

# Журналы и резервные копии — рантайм, не код (пути настраиваются
# PI_LOG_DIR / PI_BACKUP_DIR, по умолчанию сюда).
data/logs/
data/backups/

# Кэш ETag для запросов к ESI — служебный файл, не часть кода.
data/cache/etags.json
