# nginx для PI Director. Скопировать в sites-available / conf.d,
# подставить домен и пути к сертификатам.
#
# Приложение (waitress) слушает только 127.0.0.1 — снаружи виден лишь nginx.

# Ограничение частоты запросов на IP (B2). Зоны — на уровне http, то есть
# снаружи server{}: этот файл лежит в conf.d / sites-available, а они
# подключаются внутри http{}. Тяжёлые эндпоинты — расчёт плана и
# экспорт: один запрос считает секунды, и на однопоточном waitress
# лавина таких запросов с одного адреса выедает всех воркеров.
limit_req_zone $binary_remote_addr zone=pi_heavy:10m rate=3r/s;
limit_req_zone $binary_remote_addr zone=pi_api:10m   rate=20r/s;
limit_req_zone $binary_remote_addr zone=pi_auth:10m  rate=2r/s;
limit_req_status 429;

server {
    listen 80;
    server_name pi.example.com;
    # Весь HTTP — на HTTPS. EVE SSO требует https в callback URL.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name pi.example.com;

    ssl_certificate     /etc/ssl/pi.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/pi.example.com/privkey.pem;

    # Ограничение размера тела: расчёт плана — до 20 продуктов, экспорт —
    # до 500 строк. Было 1m — 18.09.2026 реальный аккаунт (87 колоний)
    # получил HTTP 413 на экспорт колоний в Excel: тело раздула
    # extraction_history (копится с 13.09.2026, ничем не ограничена,
    # ~21 000 записей на тот момент). Основной фикс — на фронтенде,
    # coloniesForExport() в web/index.html шлёт только нужные экспорту
    # поля, не весь coloniesData; 3m — разумный запас на будущее сверх
    # этого, не разрешение слать что попало.
    client_max_body_size 3m;

    # Статика фронтенда — напрямую с диска, минуя Python.
    location = / {
        root /path/to/EVE-PI-app/web;
        try_files /index.html =404;
    }
    location /assets/ {
        root /path/to/EVE-PI-app/web;
    }

    # Тяжёлые эндпоинты. burst — запас на нормальную работу интерфейса
    # (смена языка перезапрашивает несколько панелей сразу).
    location ~ ^/api/(calculate|advice|export|plan-profitability|colonies-profitability)$ {
        limit_req zone=pi_heavy burst=15 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Вход через EVE SSO и управление персонажами.
    location /api/auth/ {
        limit_req zone=pi_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Остальной API.
    location /api/ {
        limit_req zone=pi_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Всё остальное (статика web/, отдаваемая waitress) — на waitress.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
